      "id": "073ea88a-6cb6-4636-93ad-59b641b05f73",
      "name": "Get File Content",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        3360,
        1488
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst parsedItems = [];\n\nlet currentHour, currentDay;\ntry {\n  const now = DateTime.now().setZone('Europe/Zurich');\n  currentHour = now.hour;\n  currentDay = now.weekday;\n} catch (e) {\n  const d = new Date();\n  currentHour = d.getHours();\n  const day = d.getDay();\n  currentDay = day === 0 ? 7 : day;\n}\n\nfunction parseYaml(yamlText) {\n  const result = {};\n  \n  const nameMatch = yamlText.match(/^name:\\s*(.+)$/m);\n  if (nameMatch) result.name = nameMatch[1].trim().replace(/^[\"']|[\"']$/g, '');\n  \n  const descMatch = yamlText.match(/^description:\\s*(.+)$/m);\n  if (descMatch) result.description = descMatch[1].trim().replace(/^[\"']|[\"']$/g, '');\n  \n  const addedMatch = yamlText.match(/^added_by:\\s*(.+)$/m);\n  if (addedMatch) result.added_by = addedMatch[1].trim().replace(/^[\"']|[\"']$/g, '');\n  \n  const scheduleMatch = yamlText.match(/^schedule:\\s*(.+)$/m);\n  if (scheduleMatch) {\n    result.schedule = scheduleMatch[1].trim().replace(/^[\"']|[\"']$/g, '').toLowerCase();\n  } else {\n    result.schedule = 'daily';\n  }\n  \n  const queryIndex = yamlText.indexOf('query:');\n  if (queryIndex !== -1) {\n    let queryPart = yamlText.substring(queryIndex + 6);\n    queryPart = queryPart.replace(/^\\s*[|>-]+\\s*\\r?\\n/, '');\n    \n    const lines = queryPart.split(/\\r?\\n/);\n    let minIndent = Infinity;\n    for (const line of lines) {\n      if (line.trim().length > 0) {\n        const match = line.match(/^\\s*/);\n        const indent = match ? match[0].length : 0;\n        if (indent < minIndent) minIndent = indent;\n      }\n    }\n    \n    if (minIndent !== Infinity && minIndent > 0) {\n      result.query = lines.map(line => line.substring(minIndent)).join('\\n').trim();\n    } else {\n      result.query = lines.join('\\n').trim();\n    }\n  }\n  \n  return result;\n}\n\nfor (const item of items) {\n  const yamlText = item.json.data || '';\n  const parsed = parseYaml(yamlText);\n  \n  let shouldRun = false;\n  if (parsed.schedule === 'hourly') {\n    shouldRun = true;\n  } else if (parsed.schedule === 'daily') {\n    if (currentHour === 8) {\n      shouldRun = true;\n    }\n  } else if (parsed.schedule === 'weekly') {\n    if (currentDay === 1 && currentHour === 8) {\n      shouldRun = true;\n    }\n  } else {\n    if (currentHour === 8) {\n      shouldRun = true;\n    }\n  }\n  \n  if (shouldRun) {\n    parsedItems.push({ json: parsed });\n  }\n}\n\nreturn parsedItems;"
      },
