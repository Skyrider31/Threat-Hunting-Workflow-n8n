            {
              "name": "description",
              "value": "=### 🚨 Alerte Threat Hunting : {{ $('Parse YAML').item.json.name }}\n\n**Description :** {{ $('Parse YAML').item.json.description }}\n**Ajouté par :** {{ $('Parse YAML').item.json.added_by }}\n**Date du Run :** {{ $now.toISODate() }}\n**Nombre de détections :** {{ $('Defender XDR KQL Query').item.json.results.length }}\n\n---\n\n#### 🔍 Détails des détections (Top 10) :\n{{ $('Defender XDR KQL Query').item.json.results.slice(0, 10).map(r => '• ' + Object.keys(r).filter(k => !k.startsWith('@') && !k.startsWith('_') && r[k] !== null && r[k] !== '').slice(0, 6).map(k => `**${k}** : \\\\\\`${String(r[k]).substring(0,100)}\\\\\\``).join(' | ')).join('\\\\n') }}\n\n---\n*Cette alerte a été générée automatiquement.*"
            },
            {
              "name": "labels",
              "value": "threat-hunting,alert"
            }
          ]
        },
        "options": {}
      },
      "id": "cb7e0a2f-be6a-4735-9ae8-1e8282530994",
      "name": "GitLab Create Issue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        3360,
        1888
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const issueUrl = $json.web_url;\nconst results = $('Defender XDR KQL Query').item.json.results || [];\nconst hunt = $('Parse YAML').item.json;\n\nconst card = {\n  \"type\": \"AdaptiveCard\",\n  \"version\": \"1.4\",\n  \"$schema\": \"http://adaptivecards.io/schemas/adaptive-card.json\",\n  \"body\": [\n    {\n      \"type\": \"TextBlock\",\n      \"text\": `🚨 Alerte Threat Hunting : ${hunt.name}`,\n      \"weight\": \"Bolder\",\n      \"size\": \"Medium\",\n      \"color\": \"Attention\"\n    },\n    {\n      \"type\": \"FactSet\",\n      \"facts\": [\n        {\n          \"title\": \"Description\",\n          \"value\": hunt.description || \"N/A\"\n        },\n        {\n          \"title\": \"Ajouté par\",\n          \"value\": hunt.added_by || \"N/A\"\n        },\n        {\n          \"title\": \"Date du Run\",\n          \"value\": new Date().toISOString().split('T')[0]\n        },\n        {\n          \"title\": \"Détections\",\n          \"value\": String(results.length)\n        }\n      ]\n    },\n    {\n      \"type\": \"TextBlock\",\n      \"text\": \"Détails des détections (Top 10) :\",\n      \"weight\": \"Bolder\",\n      \"spacing\": \"Medium\"\n    },\n    {\n      \"type\": \"Container\",\n      \"items\": results.slice(0, 10).map((r, i) => {\n        const keys = Object.keys(r).filter(k => !k.startsWith('@') && !k.startsWith('_') && r[k] !== null && r[k] !== '').slice(0, 6);\n        return {\n          \"type\": \"FactSet\",\n          \"spacing\": i === 0 ? \"Small\" : \"Medium\",\n          \"separator\": i !== 0,\n          \"facts\": keys.map(k => ({\n            \"title\": k,\n            \"value\": String(r[k]).substring(0, 150)\n          }))\n        };\n      })\n    }\n  ],\n  \"actions\": [\n    {\n      \"type\": \"Action.OpenUrl\",\n      \"title\": \"Voir l'Issue GitLab\",\n      \"url\": issueUrl\n    }\n  ]\n};\n\nfor (let key in $json) { delete $json[key]; }\nObject.assign($json, card);\nreturn $input.item;"
      },
